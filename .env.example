# LLM provider configuration
# One of: ollama (free, local, default) | openai | anthropic
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local embedding model (no API key required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage paths
DATABASE_PATH=data/support.db
CHROMA_DIR=data/chroma_db
POLICY_DOCS_DIR=data/policies

# MCP server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
